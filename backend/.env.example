# Copy this file to .env and fill in real values. Never commit .env.

# Secret used to sign login tokens. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-me-with-a-long-random-secret

# Database location. The default SQLite file lives in the backend folder.
DATABASE_URL=sqlite:///./pharmacy_pos.db

# Pharmacy's timezone; decides what "today" means for expiry checks and reports.
APP_TIMEZONE=Asia/Karachi

# Folder for automatic backups. Leave empty to use backend/backups.
BACKUP_DIR=

# How many backup files to keep; older ones are deleted.
BACKUP_KEEP=30

# Hours between automatic backups while the backend is running.
BACKUP_INTERVAL_HOURS=6
